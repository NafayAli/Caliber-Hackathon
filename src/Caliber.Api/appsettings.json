{
  "ConnectionStrings": {
    "Caliber": "Server=(localdb)\\MSSQLLocalDB;Database=Caliber;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Evidence": {
    "StoragePath": "App_Data/evidence",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "Avatars": {
    "StoragePath": "App_Data/avatars",
    "MaxFileSizeBytes": 2097152,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
